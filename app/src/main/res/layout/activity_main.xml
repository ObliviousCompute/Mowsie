<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blast_door">

    <!-- Insets are applied as padding to the root FrameLayout in ControlPanel.
         This content face fills only the interior, leaving the top status-bar
         inset the exact same solid color as the upper blast door. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oblivion_chamber"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/logoToggle"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mowsie hood" />

        <FrameLayout
            android:id="@+id/windowStack"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/mainContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <com.mowsie.app.PhosphorTextView
                    android:id="@+id/identityName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/stash_name"
                    android:textColor="#F5F8FC"
                    android:textSize="21sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/qrWindow"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="8dp"
                    android:translationY="-10dp"
                    android:background="@android:color/transparent">

                    <com.mowsie.app.MowsieQrView
                        android:id="@+id/qrPattern"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="Mowsie public identity QR code"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false" />

                    <com.mowsie.app.PhosphorTextView
                        android:id="@+id/qrPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/scan_placeholder"
                        android:textColor="#93ACC6"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bottomDoorContainer"
                    android:layout_width="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="Selected field door">

                    <com.mowsie.app.BottomDoorView
                        android:id="@+id/bottomDoorSurface"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="18dp"
                        android:paddingTop="342dp"
                        android:paddingRight="18dp"
                        android:paddingBottom="12dp">

                        <!-- The stored Stash identity moves WITH the lower door. -->
                        <com.mowsie.app.PhosphorTextView
                            android:id="@+id/stashDoorName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Public identity. Tap to raise or lower the field door"
                            android:gravity="center"
                            android:text="Metronome"
                            android:textColor="#F5F8FC"
                            android:textSize="22sp" />

                        <com.mowsie.app.PhosphorTextView
                            android:id="@+id/fieldName"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Bob's Donuts"
                            android:textColor="#F0F3FA"
                            android:textSize="19sp" />

                        <com.mowsie.app.PhosphorTextView
                            android:id="@+id/balanceText"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="10,485.75 Salt"
                            android:textColor="#93ACC6"
                            android:textSize="15sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hoodPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp"
                android:visibility="invisible">

                <GridLayout
                    android:id="@+id/wordGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="3"
                    android:rowCount="4" />

                <!-- Grid -> action -> indicator. The action position NEVER moves. -->
                <FrameLayout
                    android:id="@+id/recoveryActionSlot"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">

                    <!-- Reveal / Restore / Save are plain, centered text. -->
                    <com.mowsie.app.PhosphorTextView
                        android:id="@+id/revealButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="Reveal"
                        android:textColor="#F0F3FA"
                        android:textSize="20sp" />

                    <!-- Secret is masked IN the same position as Reveal.
                         No border, underline, or blinking Android caret. -->
                    <com.mowsie.app.PhosphorEditText
                        android:id="@+id/recoverySecret"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:singleLine="true"
                        android:cursorVisible="false"
                        android:defaultFocusHighlightEnabled="false"
                        android:textColor="#F0F3FA"
                        android:textSize="20sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Permanent reserved indicator row. Copied / Pasted / Secret
                     prompts never reflow the recovery grid or action. -->
                <com.mowsie.app.PhosphorStatusTextView
                    android:id="@+id/recoveryHint"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:textColor="#667587"
                    android:textSize="20sp"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <com.mowsie.app.PhosphorButton
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="0dp"
            android:alpha="0"
            android:backgroundTint="#496F97"
            android:clickable="false"
            android:enabled="false"
            android:text="@string/send"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
