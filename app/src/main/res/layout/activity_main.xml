<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C1521">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/logoToggle"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mowsie hood" />

        <FrameLayout
            android:id="@+id/windowStack"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/mainContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/identityName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/stash_name"
                    android:textColor="#F5F8FC"
                    android:textSize="21sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/qrWindow"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="8dp"
                    android:background="@android:color/transparent">

                    <com.mowsie.app.MowsieQrView
                        android:id="@+id/qrPattern"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="Mowsie public identity QR code"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/qrPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/scan_placeholder"
                        android:textColor="#93ACC6"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bottomDoorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="Selected field door">

                    <com.mowsie.app.BottomDoorView
                        android:id="@+id/bottomDoorSurface"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="18dp"
                        android:paddingTop="57dp"
                        android:paddingRight="18dp"
                        android:paddingBottom="12dp">

                        <!-- The stored Stash identity moves WITH the lower door. -->
                        <TextView
                            android:id="@+id/stashDoorName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Tap to raise or lower the field door"
                            android:gravity="center"
                            android:text="Metronome"
                            android:textColor="#F5F8FC"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/fieldName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Bob's Donuts"
                            android:textColor="#F0F3FA"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/balanceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="10,485.75 Salt"
                            android:textColor="#93ACC6"
                            android:textSize="15sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hoodPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recovery"
                        android:textColor="#F5F8FC"
                        android:textSize="21sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/settingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:contentDescription="Advanced settings"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⚙"
                        android:textColor="#BED0E1"
                        android:textSize="27sp" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/wordGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:columnCount="3"
                    android:rowCount="4" />

                <TextView
                    android:id="@+id/recoveryHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Recovery words arrive with Genesis."
                    android:textColor="#9FB2C8"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/revealButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#496F97"
                    android:text="Reveal"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="0dp"
            android:alpha="0"
            android:backgroundTint="#496F97"
            android:clickable="false"
            android:enabled="false"
            android:text="@string/send"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
